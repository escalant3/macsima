    "Maxima stopped: %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maxima se ha detenido: %@"
          }
        }
      }
    },
    "Maxima tried to find out where between two points a curve crosses the zero line. Since the curve is on the same side of the zero line in both points its algorithms fails here. Set find_root_error to false if you want it to return false instead of an error." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maxima ha intentado averiguar en qué punto entre dos puntos una curva cruza el eje cero. Como la curva está del mismo lado del cero en ambos puntos, sus algoritmos fallan aquí. Asigna false a find_root_error si prefieres que devuelva false en vez de un error."
          }
        }
      }
    },
    "Maxima was restarted" : {
      "comment" : "Why a session ended",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maxima se ha reiniciado"
          }
        }
      }
