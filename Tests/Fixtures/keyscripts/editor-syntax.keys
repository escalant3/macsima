# Editor features (Phase 3, step 3): syntax highlighting first. Dumps go to
# .build/keyscripts/ and are checked by run.sh.
wait 2
type /* note */ f(x):=if x>1.5e3 then sin(x) else "big"; ?car $
dump .build/keyscripts/editor-syntax-1.json
shot .build/keyscripts/editor-syntax-1.png
# Matching brackets: after the closing parenthesis, then after "]".
key 0 cmd
type g(a[1], "(")
dump .build/keyscripts/editor-syntax-2.json
key left
key left
key left
key left
key left
key left
dump .build/keyscripts/editor-syntax-3.json
key right
dump .build/keyscripts/editor-syntax-4.json
# Arrow keys between cells (step 3d). The caret is at 7 in the second cell.
key up
dump .build/keyscripts/editor-syntax-5.json
key down
dump .build/keyscripts/editor-syntax-6.json
key down
dump .build/keyscripts/editor-syntax-7.json
key 0 cmd
type aaa
key return
type bb
key up
dump .build/keyscripts/editor-syntax-8.json
key up
dump .build/keyscripts/editor-syntax-9.json
# Auto-indent (3f) and Cmd+/ (3g), in a new code cell.
key 0 cmd
type f(x):=block([a],
key return
type a:x,
key return
type a^2
key return
type )$
dump .build/keyscripts/editor-syntax-10.json
key / cmd
dump .build/keyscripts/editor-syntax-11.json
key / cmd
dump .build/keyscripts/editor-syntax-12.json
key z cmd
dump .build/keyscripts/editor-syntax-13.json
quit
