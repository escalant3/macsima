# Error marks (Phase 3, step 4): the failing statement in the input, the
# spot of a syntax error, an unbalanced bracket, and the explanation marker.
wait 3
# Up goes from input to input here (testArrowKeysStopOnOutputs covers stopping on outputs).
setting ArrowKeysSkipOutput true
type a:1$ b:1/0; c:3;
key return shift
type f(a,,b);
key return shift
type g(x:=2;
key return shift
wait 3
dump .build/keyscripts/errors-1.json
shot .build/keyscripts/errors.png
key up
key up
type x
dump .build/keyscripts/errors-2.json
quit
